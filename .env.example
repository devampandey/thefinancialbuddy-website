# Copy this file to .env.local for local development (never commit the
# real .env.local — it's already in .gitignore). For production, add each
# of these in the Vercel dashboard: Project → Settings → Environment
# Variables.

# Random long string used to sign staff login sessions. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# --- GitHub (lets the admin panel commit articles to this repo) ---
# Create a fine-grained personal access token at
# https://github.com/settings/personal-access-tokens/new scoped to ONLY
# this repository, with Contents: Read and write permission. Nothing else.
GITHUB_TOKEN=
GITHUB_OWNER=devampandey
GITHUB_REPO=thefinancialbuddy-website
GITHUB_BRANCH=main

# --- Admin account (full access: write + approve/publish) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Writer accounts (can write + submit drafts, cannot publish) ---
# Add up to WRITER_USERNAME_4 / WRITER_PASSWORD_4 / WRITER_NAME_4 if you
# hire more writers later — no code changes needed.
WRITER_USERNAME_1=
WRITER_PASSWORD_1=
WRITER_NAME_1=

WRITER_USERNAME_2=
WRITER_PASSWORD_2=
WRITER_NAME_2=

# --- Analytics / Search Console (both optional) ---
# Google Search Console → Add property → HTML tag method → paste just the
# "content" value from the meta tag it gives you (not the whole tag).
GSC_VERIFICATION=

# Google Analytics → Admin → Data Streams → your web stream → Measurement ID
# (starts with "G-"). Must be NEXT_PUBLIC_ prefixed since it runs in the
# browser.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google AdSense (optional) ---
# The "client" value (starts with "ca-pub-") from the adsbygoogle.js script
# tag AdSense gives you on the "connect your site" step. Must be
# NEXT_PUBLIC_ prefixed since it runs in the browser. public/ads.txt is
# already set with this account's publisher ID (pub-4942421293512949) —
# update it too if this ever changes to a different AdSense account.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# --- Newsletter (Buttondown) ---
# Buttondown dashboard → Settings → Programming → API key. Powers the
# in-page "Get new posts by email" subscribe box (app/api/subscribe).
# Never exposed to the browser — used server-side only.
BUTTONDOWN_API_KEY=

# --- Gold/Silver rates: Metals.Dev (optional) ---
# Sign up free at https://metals.dev (no card required) → Dashboard → copy
# your API key. Powers real MCX (India) gold/silver rates on the Gold Rate /
# Silver Rate pages instead of an international-spot-price estimate. If this
# is left blank, those pages automatically fall back to the estimate — the
# site still works, the numbers are just less precise.
# Free plan = 100 requests/month, which is why the site only refreshes this
# every 8 hours (see MCX_REVALIDATE_SECONDS in lib/metals.js) — lower that
# number if you upgrade to a paid plan for fresher updates.
METALS_DEV_API_KEY=

# --- Browser push notifications (optional) ---
# A VAPID key pair identifies this site to browsers' push services — it's
# not a third-party account, just a keypair generated for this app. If
# these are blank, the "Enable notifications" prompt won't render at all
# (NotificationPrompt checks for NEXT_PUBLIC_VAPID_PUBLIC_KEY before doing
# anything), so the site works fine without them too.
# NEXT_PUBLIC_ prefix is required on the public key since the browser needs
# to read it directly — it's not sensitive, unlike the private key below.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Auto-post new articles to Bluesky (optional) ---
# 1. Create (or use your existing) Bluesky account.
# 2. bsky.app → Settings → Privacy and Security → App Passwords → Add App
#    Password. This is a scoped credential, separate from your real login
#    password — use it here, never your actual password.
# BLUESKY_IDENTIFIER is your handle, e.g. financialbuddy.bsky.social
# If either is blank, publishing an article just skips the Bluesky post —
# nothing breaks.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
