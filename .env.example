# Copy this file to .env.local for local development (never commit the
# real .env.local — it's already in .gitignore). For production, add each
# of these in the Vercel dashboard: Project → Settings → Environment
# Variables.

# Random long string used to sign staff login sessions. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# --- GitHub (lets the admin panel commit articles to this repo) ---
# Create a fine-grained personal access token at
# https://github.com/settings/personal-access-tokens/new scoped to ONLY
# this repository, with Contents: Read and write permission. Nothing else.
GITHUB_TOKEN=
GITHUB_OWNER=devampandey
GITHUB_REPO=thefinancialbuddy-website
GITHUB_BRANCH=main

# --- Admin account (full access: write + approve/publish) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Writer accounts (can write + submit drafts, cannot publish) ---
# Add up to WRITER_USERNAME_4 / WRITER_PASSWORD_4 / WRITER_NAME_4 if you
# hire more writers later — no code changes needed.
WRITER_USERNAME_1=
WRITER_PASSWORD_1=
WRITER_NAME_1=

WRITER_USERNAME_2=
WRITER_PASSWORD_2=
WRITER_NAME_2=

# --- Analytics / Search Console (both optional) ---
# Google Search Console → Add property → HTML tag method → paste just the
# "content" value from the meta tag it gives you (not the whole tag).
GSC_VERIFICATION=

# Google Analytics → Admin → Data Streams → your web stream → Measurement ID
# (starts with "G-"). Must be NEXT_PUBLIC_ prefixed since it runs in the
# browser.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Newsletter (Buttondown) ---
# Buttondown dashboard → Settings → Programming → API key. Powers the
# in-page "Get new posts by email" subscribe box (app/api/subscribe).
# Never exposed to the browser — used server-side only.
BUTTONDOWN_API_KEY=
